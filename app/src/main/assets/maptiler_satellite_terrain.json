        "https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=il3KGdrwRY1RGiUuAlLr"
      ],
      "scheme": "tms",
      "tileSize": 512,
      "minzoom": 0,
