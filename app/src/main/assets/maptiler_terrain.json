{
  "version": 8,
  "name": "ForestNavigator Terrain",
  "sources": {
    "topo": {
      "type": "raster",
      "tiles": [
        "https://a.tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 17,
      "attribution": "© OpenStreetMap contributors, SRTM; © OpenTopoMap (CC-BY-SA)"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "https://api.maptiler.com/tiles/terrain-rgb-v2/tiles.json?key=il3KGdrwRY1RGiUuAlLr",
      "tileSize": 512,
      "maxzoom": 14,
      "encoding": "mapbox"
    }
  },
  "layers": [
    {
      "id": "topo",
      "type": "raster",
      "source": "topo"
    },
    {
      "id": "terrain-hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": 0.72,
        "hillshade-shadow-color": "#30281f",
        "hillshade-highlight-color": "#fff8e6",
        "hillshade-accent-color": "#75634a"
      }
    }
  ]
}
